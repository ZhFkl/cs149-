{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug mandelbrot",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/mandelbrot",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug mandelbrot (view 2, 8 threads)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/mandelbrot",
            "args": ["--view", "2", "-t", "8"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
